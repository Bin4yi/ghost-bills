# Ghost Bills: Auth0 settings. Copy to .env and fill in. Never commit .env.
# Leave AUTH0_DOMAIN empty to run fully local and offline (no login, no sending).

# --- Tenant ---
AUTH0_DOMAIN=                      # e.g. your-tenant.us.auth0.com

# --- Regular Web Application "Ghost Bills Web" (user login AND the step-up MFA approval) ---
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
APP_BASE_URL=http://localhost:5173 # where the browser opens the app
SESSION_SECRET=                    # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"

# --- APIs (one per hop; see README "Auth0 setup") ---
AUTH0_AUDIENCE=https://ghost-bills.local/login      # user's login token audience
LEDGER_AUDIENCE=https://ghost-bills.local/ledger    # Penny's token (scope read:ghosts)
COURIER_AUDIENCE=https://ghost-bills.local/courier  # Courier's token (scope send:cancel_email)

# --- Custom API Client "Penny" (identifier = AUTH0_AUDIENCE, On-Behalf-Of on) ---
PENNY_CLIENT_ID=
PENNY_CLIENT_SECRET=

# --- Custom API Client "Courier" (identifier = LEDGER_AUDIENCE, On-Behalf-Of + Token Vault on) ---
COURIER_CLIENT_ID=
COURIER_CLIENT_SECRET=

# --- Google (Token Vault) ---
GOOGLE_CONNECTION=google-oauth2
